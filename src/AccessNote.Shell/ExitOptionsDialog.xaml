<Window x:Class="AccessNote.ExitOptionsDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Options"
        Width="450"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="What would you like to do?"
               FontSize="24"
               FontWeight="Bold"
               Foreground="{DynamicResource ThemeHeaderForeground}"
               Margin="0,0,0,20"
               HorizontalAlignment="Center"
               AutomationProperties.Name="Exit options question" />

    <ListBox x:Name="OptionsList"
             Grid.Row="1"
             FontSize="22"
             Foreground="{DynamicResource ThemeForeground}"
             Background="{DynamicResource ThemeMenuBackground}"
             BorderBrush="{DynamicResource ThemeBorder}"
             BorderThickness="2"
             Padding="8"
             FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="Exit options">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="12" />
          <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBoxItem>Exit Access Note</ListBoxItem>
      <ListBoxItem>Shut Down Computer</ListBoxItem>
      <ListBoxItem>Cancel</ListBoxItem>
    </ListBox>

    <TextBlock Grid.Row="2"
               Text="Up/Down to navigate, Enter to select, Escape to cancel"
               FontSize="14"
               Foreground="{DynamicResource ThemeForeground}"
               Margin="0,12,0,0"
               HorizontalAlignment="Center"
               AutomationProperties.Name="Instructions" />
  </Grid>
</Window>
