<Window x:Class="AccessNote.ContextMenuDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Menu"
        Width="450"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Current applet header -->
    <TextBlock x:Name="AppletHeaderText"
               Grid.Row="0"
               FontSize="24"
               FontWeight="Bold"
               Foreground="{DynamicResource ThemeHeaderForeground}"
               Margin="0,0,0,16"
               AutomationProperties.Name="Context menu for applet" />

    <!-- Menu items -->
    <ListBox x:Name="MenuItemsList"
             Grid.Row="1"
             FontSize="22"
             Foreground="{DynamicResource ThemeForeground}"
             Background="{DynamicResource ThemeMenuBackground}"
             BorderBrush="{DynamicResource ThemeBorder}"
             BorderThickness="2"
             Padding="8"
             FocusVisualStyle="{x:Null}"
             MouseDoubleClick="OnMenuItemDoubleClick"
             AutomationProperties.Name="Context menu items">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="12" />
          <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <!-- Instructions -->
    <TextBlock Grid.Row="2"
               Text="Up/Down to navigate, Enter to select, Escape to close"
               FontSize="14"
               Foreground="{DynamicResource ThemeForeground}"
               Margin="0,12,0,0"
               AutomationProperties.Name="Instructions" />
  </Grid>
</Window>
